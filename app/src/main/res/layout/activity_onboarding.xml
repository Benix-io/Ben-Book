<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:padding="24dp">

    <!-- Centered Logo and Text Content -->
    <LinearLayout
        android:id="@+id/card_center_onboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_onboard_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_app_symbol" />

        <TextView
            android:id="@+id/tv_onboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="⚡ Welcome to Benbook"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_onboard_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Lightning-fast native code organizer and developer snippet notebook."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- Bottom Container: 3 Dots strictly centered + Next/Finish button -->
    <LinearLayout
        android:id="@+id/bottom_controls_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 3 Centered Dots -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="●"
                android:textColor="#38BDF8"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/dot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="●"
                android:textColor="#334155"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/dot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="●"
                android:textColor="#334155"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Next / Finish Button -->
        <Button
            android:id="@+id/btn_onboard_next"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Next →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
